# ============================================================
# Repo Sync Tool - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
#
# Commented-out variables are optional. Uncomment and set them
# only when you need the corresponding feature.
#
# For Docker deployments, see also .env.docker.example.
# ============================================================


# ==========================
# 1. Application Environment
# ==========================

# Node.js environment: development | production | test
# Controls stack traces in API errors, dev-only routes, and console hotkeys.
NODE_ENV=development


# ==========================
# 2. Azure Storage (Global)
# ==========================
# Configures the global storage target for single-repo replication
# (clone-github, clone-devops). Optional if running sync-pairs-only mode.

# Azure Storage Account URL
# Example: https://myaccount.blob.core.windows.net
# AZURE_STORAGE_ACCOUNT_URL=

# Default blob container name
# AZURE_STORAGE_CONTAINER_NAME=

# Authentication method: connection-string | sas-token | azure-ad
# AZURE_FS_AUTH_METHOD=

# Connection string (required when AZURE_FS_AUTH_METHOD=connection-string)
# Find in: Azure Portal > Storage Account > Access Keys
# AZURE_STORAGE_CONNECTION_STRING=

# SAS token (required when AZURE_FS_AUTH_METHOD=sas-token, no leading ?)
# Generate in: Azure Portal > Storage Account > Shared Access Signature
# AZURE_STORAGE_SAS_TOKEN=

# SAS token expiry in ISO 8601 format (required when AZURE_FS_AUTH_METHOD=sas-token)
# Must match the expiry date set when generating the SAS token.
# The app warns 7 days before expiry.
# Example: 2026-12-31T00:00:00Z
# AZURE_STORAGE_SAS_TOKEN_EXPIRY=


# ==========================
# 3. GitHub Replication
# ==========================

# GitHub Personal Access Token (required for private repos, optional for public)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (for private repos)
# GITHUB_TOKEN=

# GitHub token expiry in ISO 8601 format (optional, warns 7 days before expiry)
# GITHUB_TOKEN_EXPIRY=


# ==========================
# 4. Azure DevOps Replication
# ==========================

# Azure DevOps auth method: pat | azure-ad
# AZURE_DEVOPS_AUTH_METHOD=pat

# Default Azure DevOps organization URL
# Example: https://dev.azure.com/myorg
# AZURE_DEVOPS_ORG_URL=

# Azure DevOps Personal Access Token (required when auth method is pat)
# Generate in: Azure DevOps > User Settings > Personal Access Tokens
# Required scopes: Code (Read)
# AZURE_DEVOPS_PAT=

# Azure DevOps PAT expiry in ISO 8601 format (optional, warns 7 days before expiry)
# AZURE_DEVOPS_PAT_EXPIRY=


# ==========================
# 5. Sync Pair Configuration
# ==========================

# Path to sync pair configuration file (JSON or YAML).
# Can be a local file path or an Azure Blob Storage URL.
# For Azure Blob URLs (.blob.core.windows.net), AZURE_VENV_SAS_TOKEN is auto-appended.
# Can be overridden via CLI: --sync-config <path>
# AZURE_FS_SYNC_CONFIG_PATH=


# ==========================
# 6. Azure VENV (Remote Config Bootstrap)
# ==========================
# azure-venv reads blobs and a remote .env from Azure Blob Storage at startup,
# merging remote env vars into process.env. This is how the container loads
# secrets without baking them into the image.

# Azure Blob Storage URL for remote config sync
# Format: https://<account>.blob.core.windows.net/<container>/<prefix>
# AZURE_VENV=

# SAS token for azure-venv blob access (Read + List permissions, no leading ?)
# AZURE_VENV_SAS_TOKEN=

# SAS token expiry in ISO 8601 format (optional, warns 7 days before expiry)
# AZURE_VENV_SAS_EXPIRY=

# Watch mode polling interval in milliseconds (default: 30000, range: 5000-3600000)
# azure-venv re-reads blobs at this interval to pick up remote changes.
# AZURE_VENV_POLL_INTERVAL=30000

# SAS token with write+create permissions for writing sync pair config back to
# Azure Blob Storage (no leading ?). Used by the manage-sync-pairs skill.
# Falls back to AZURE_VENV_SAS_TOKEN if not set.
# Required permissions: sp=rwc (read + write + create)
# AZURE_VENV_SAS_WRITE_TOKEN=

# Expiry date for AZURE_VENV_SAS_WRITE_TOKEN in ISO 8601 format (optional)
# AZURE_VENV_SAS_WRITE_TOKEN_EXPIRY=


# ==========================
# 7. Logging
# ==========================

# Log level: debug | info | warn | error
AZURE_FS_LOG_LEVEL=info

# Log Azure SDK HTTP requests: true | false
AZURE_FS_LOG_REQUESTS=false


# ==========================
# 8. Retry Configuration
# ==========================

# Retry strategy: none | exponential | fixed
AZURE_FS_RETRY_STRATEGY=exponential

# Maximum number of retries
AZURE_FS_RETRY_MAX_RETRIES=3

# Initial delay in milliseconds
AZURE_FS_RETRY_INITIAL_DELAY_MS=1000

# Maximum delay in milliseconds (exponential backoff cap)
AZURE_FS_RETRY_MAX_DELAY_MS=30000


# ==========================
# 9. REST API Server
# ==========================

# Port the API server listens on
AZURE_FS_API_PORT=3000

# Host/IP to bind to (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
AZURE_FS_API_HOST=0.0.0.0

# Auto-select next available port if configured port is in use: true | false
AUTO_SELECT_PORT=false

# Comma-separated allowed CORS origins (* for all, or specific URLs)
AZURE_FS_API_CORS_ORIGINS=*

# Enable Swagger UI at /api/docs: true | false
AZURE_FS_API_SWAGGER_ENABLED=true

# Request timeout in milliseconds (requests exceeding this are aborted)
AZURE_FS_API_REQUEST_TIMEOUT_MS=30000

# Comma-separated additional Swagger server URLs for multi-environment testing
# AZURE_FS_API_SWAGGER_ADDITIONAL_SERVERS=

# Enable Swagger server variables for URL editing in Swagger UI: true | false
# AZURE_FS_API_SWAGGER_SERVER_VARIABLES=false


# ==========================
# 10. Deployment / URL Detection
# ==========================
# These control how Swagger determines the public server URL.
# Priority: PUBLIC_URL > WEBSITE_HOSTNAME > K8S_SERVICE_* > DOCKER_HOST_URL > localhost

# Explicit public URL override (works in any environment)
# PUBLIC_URL=

# Docker container public URL for Swagger URL detection
# Example: http://localhost:4100
# DOCKER_HOST_URL=

# Force HTTPS for Kubernetes environments: true | false
# Only relevant when K8S_SERVICE_HOST/K8S_SERVICE_PORT are set.
# AZURE_FS_API_USE_HTTPS=false

# The following are auto-set by their respective platforms -- DO NOT SET MANUALLY:
# WEBSITE_HOSTNAME   (Azure App Service)
# WEBSITE_SITE_NAME  (Azure App Service)
# K8S_SERVICE_HOST   (Kubernetes)
# K8S_SERVICE_PORT   (Kubernetes)
