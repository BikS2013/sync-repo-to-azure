# ============================================================
# Repo Sync API - Docker Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values
# before running: docker compose up
#
# Variables marked (optional) can be left empty or commented out.
# Variables marked (required) must be set for the feature to work.
# ============================================================

# ---- Application Environment ----

# Application environment: development | production | test (required for API mode)
NODE_ENV=development

# ---- Azure Storage Configuration (Global) ----
# These configure the global storage target for single-repo replication
# (clone-github, clone-devops). Optional if running sync-pairs-only.

# Azure Storage Account URL (e.g., https://myaccount.blob.core.windows.net)
# AZURE_STORAGE_ACCOUNT_URL=

# Default container name
# AZURE_STORAGE_CONTAINER_NAME=

# Authentication method: connection-string | sas-token | azure-ad
# AZURE_FS_AUTH_METHOD=

# Connection string (required when AZURE_FS_AUTH_METHOD=connection-string)
# AZURE_STORAGE_CONNECTION_STRING=

# SAS token (required when AZURE_FS_AUTH_METHOD=sas-token, no leading ?)
# AZURE_STORAGE_SAS_TOKEN=

# SAS token expiry in ISO 8601 format (required when AZURE_FS_AUTH_METHOD=sas-token)
# AZURE_STORAGE_SAS_TOKEN_EXPIRY=

# ---- GitHub Configuration ----

# GitHub Personal Access Token for repo replication (required for private repos)
# GITHUB_TOKEN=

# GitHub token expiry in ISO 8601 format (optional, warns 7 days before expiry)
# GITHUB_TOKEN_EXPIRY=

# ---- Azure DevOps Configuration ----

# Azure DevOps auth method: pat | azure-ad
# AZURE_DEVOPS_AUTH_METHOD=pat

# Default Azure DevOps organization URL (e.g., https://dev.azure.com/myorg)
# AZURE_DEVOPS_ORG_URL=

# Azure DevOps Personal Access Token for repo replication
# AZURE_DEVOPS_PAT=

# Azure DevOps PAT expiry in ISO 8601 format (optional, warns 7 days before expiry)
# AZURE_DEVOPS_PAT_EXPIRY=

# ---- Sync Pair Configuration ----

# Local path or HTTP(S) URL to sync pair configuration file (JSON/YAML).
# For Azure Blob URLs (.blob.core.windows.net), AZURE_VENV_SAS_TOKEN is auto-appended.
# AZURE_FS_SYNC_CONFIG_PATH=

# ---- Azure VENV (Remote Config Bootstrap) ----
# These configure azure-venv, which reads blobs + .env from Azure Blob Storage at startup.

# SAS token for Azure Blob Storage URL-based config fetching (no leading ?)
# Auto-appended to .blob.core.windows.net URLs.
# AZURE_VENV_SAS_TOKEN=

# SAS token expiry in ISO 8601 format for proactive warnings (optional)
# AZURE_VENV_SAS_EXPIRY=

# Watch mode polling interval in milliseconds (default: 30000, range: 5000-3600000)
# AZURE_VENV_POLL_INTERVAL=30000

# SAS token with write+create permissions for writing sync pair config back to Azure Blob
# Storage (no leading ?). Used by manage-sync-pairs skill. Falls back to AZURE_VENV_SAS_TOKEN.
# AZURE_VENV_SAS_WRITE_TOKEN=

# Expiry date for AZURE_VENV_SAS_WRITE_TOKEN in ISO 8601 format (optional)
# AZURE_VENV_SAS_WRITE_TOKEN_EXPIRY=

# ---- Logging ----

AZURE_FS_LOG_LEVEL=info
AZURE_FS_LOG_REQUESTS=false

# ---- Retry Configuration ----

AZURE_FS_RETRY_STRATEGY=exponential
AZURE_FS_RETRY_MAX_RETRIES=3
AZURE_FS_RETRY_INITIAL_DELAY_MS=1000
AZURE_FS_RETRY_MAX_DELAY_MS=30000

# ---- REST API Configuration ----

AZURE_FS_API_PORT=3000
AZURE_FS_API_HOST=0.0.0.0
AZURE_FS_API_CORS_ORIGINS=*
AZURE_FS_API_SWAGGER_ENABLED=true
AZURE_FS_API_REQUEST_TIMEOUT_MS=30000
AUTO_SELECT_PORT=false

# Comma-separated additional Swagger server URLs (optional)
# AZURE_FS_API_SWAGGER_ADDITIONAL_SERVERS=

# Enable Swagger server variables for URL editing: true/false (optional)
# AZURE_FS_API_SWAGGER_SERVER_VARIABLES=false

# ---- Container / Deployment Environment (Optional) ----

# Docker container public URL for Swagger URL detection
# Set this when running in Docker to get correct Swagger server URL.
# Example: http://localhost:4100
# DOCKER_HOST_URL=

# Explicit public URL override for Swagger server URL (any environment)
# Takes precedence over all auto-detection (DOCKER_HOST_URL, WEBSITE_HOSTNAME, etc.)
# PUBLIC_URL=
